## Как считать остаток — единая функция

```typescript
async function getRemaining(purchaseItemId: number): Promise<Decimal> {
  const item = await prisma.purchaseItem.findUniqueOrThrow({
    where: { id: purchaseItemId },
    select: {
      targetRemainder: true,
      orderLines: {
        where: { status: 'ACTIVE' },
        select: { quantity: true }
      }
    }
  })

  if (!item.targetRemainder) return new Decimal(0)

  const taken = item.orderLines.reduce(
    (sum, line) => sum.plus(line.quantity),
    new Decimal(0)
  )

  return item.targetRemainder.minus(taken)
}
```

