DATABASE_URL=
# Base URL фронтенда (кнопка Mini App откроет {WEBAPP_URL}/tg/webapp)
WEBAPP_URL=
BOT_TOKEN=
# ID канала для публикации (Bot API: -100…; @userinfobot или лог бота после старта)
TG_CHANNEL_ID=-1001234567890
# Чат сбора заявок / группа обсуждений канала (тот же формат -100…)
TG_ORDERS_CHAT_ID=-1009876543210
# URL Mini App для кнопки (если нет WEBAPP_URL: TELEGRAM_BOT_USERNAME + TELEGRAM_MINI_APP_SHORT_NAME)
TELEGRAM_MINI_APP_URL=
# Бот — админ в группе обсуждений; в @BotFather: Bot Settings → Group Privacy → Turn off
TELEGRAM_PROXY=
REDIS_URL=

# Yandex S3 (те же ключи, что у frontend — для фото в постах канала)
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET_NAME=
# LOCAL_UPLOAD_DIR=uploads
