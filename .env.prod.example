# ─── Infrastructure ────────────────────────────────────────────────────────

# PostgreSQL. DATABASE_URL is assembled in docker-compose from these three.
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=zakupki

# Redis password (used by both the redis service and the frontend).
REDIS_PASSWORD=change_me_redis

# ─── Application (required to boot) ────────────────────────────────────────

# next-auth JWT signing secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Telegram bot token from @BotFather. The bot runs inside the frontend container.
BOT_TOKEN=

# VK ID app id (numeric). Required for VK login.
NEXT_PUBLIC_VK_APP_ID=

# Telegram bot numeric id — used by the client-side Telegram Login widget.
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# ─── Feature flags (app boots without these) ───────────────────────────────
# Channel to publish product posts to (Bot API -100... form).
TG_CHANNEL_ID=-1001234567890
TELEGRAM_CHANNEL_ID=-1001234567890
# Chat to collect orders from (Bot API -100... form).
TG_ORDERS_CHAT_ID=-1009876543210

# ─── Optional ───────────────────────────────────────────────────────────────
# Base URL of the web app for bot buttons (Mini App link fallback).
WEBAPP_URL=

NEXT_PUBLIC_VK_REDIRECT_URL=
NEXT_PUBLIC_BOT_USERNAME=

# Yandex Object Storage. Leave blank to store files locally (uploads/ volume).
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET_NAME=
YANDEX_PUBLIC_URL_PREFIX=https://storage.yandexcloud.net/BUCKET_NAME
