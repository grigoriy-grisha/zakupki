# Staging stand — https://stage.scheglove.ru (copy of prod DB, separate bot, DEMO T-Bank).
# Lives on the server as /root/stage/.env.stage (not in git).
HOST=stage.scheglove.ru
ACME_EMAIL=

POSTGRES_USER=zakupki
POSTGRES_PASSWORD=
POSTGRES_DB=zakupki_stage
REDIS_PASSWORD=

NEXTAUTH_SECRET=
NEXTAUTH_URL=https://stage.scheglove.ru
AUTH_TRUST_HOST=true

# Separate staging bot (never the prod bot). BotFather: /setdomain stage.scheglove.ru
BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_ID=
NEXT_PUBLIC_BOT_USERNAME=
TELEGRAM_PROXY=
# Prod channels/chats intentionally empty — staging never posts to live channels.
TG_CHANNEL_ID=
TELEGRAM_CHANNEL_ID=
TG_ORDERS_CHAT_ID=
TELEGRAM_MINI_APP_URL=

WEBAPP_URL=https://stage.scheglove.ru
APP_PUBLIC_URL=https://stage.scheglove.ru

NEXT_PUBLIC_VK_APP_ID=
NEXT_PUBLIC_VK_REDIRECT_URL=https://stage.scheglove.ru

# S3 without access keys: staging can't delete/overwrite prod files; uploads go to the uploads-stage volume.
YANDEX_BUCKET_NAME=
YANDEX_PUBLIC_URL_PREFIX=

# T-Bank DEMO terminal only
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
