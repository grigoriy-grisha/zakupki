generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Characteristic {
  id             Int                              @id @default(autoincrement())
  name           String                           @unique
  position       Int                              @default(0)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  attributeLinks ProductAttributeCharacteristic[]
  products       ProductCharacteristicValue[]
}

model AttributeType {
  id          Int                @id @default(autoincrement())
  name        String
  position    Int                @default(0)
  showInTitle Boolean            @default(true)
  createdAt   DateTime           @default(now())
  parentId    Int?
  parent      AttributeType?     @relation("AttributeTypeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    AttributeType[]    @relation("AttributeTypeTree")
  attributes  ProductAttribute[]

  @@index([position])
  @@index([parentId])
}

model ProductAttribute {
  id              Int                              @id @default(autoincrement())
  typeId          Int
  name            String
  position        Int                              @default(0)
  createdAt       DateTime                         @default(now())
  isBrand         Boolean                          @default(false)
  parentId        Int?
  showInTitle     Boolean                          @default(true)
  brandProducts   Product[]                        @relation("ProductBrand")
  parent          ProductAttribute?                @relation("AttributeValueTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        ProductAttribute[]               @relation("AttributeValueTree")
  type            AttributeType                    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  characteristics ProductAttributeCharacteristic[]
  values          ProductAttributeValue[]

  @@index([typeId])
  @@index([parentId])
  @@index([isBrand])
}

model ProductAttributeCharacteristic {
  attributeId      Int
  characteristicId Int
  position         Int              @default(0)
  attribute        ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  characteristic   Characteristic   @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@id([attributeId, characteristicId])
  @@index([characteristicId])
  @@index([attributeId, position])
}

model ProductAttributeValue {
  productId   Int
  attributeId Int
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([attributeId])
}

model ProductCharacteristicValue {
  productId        Int
  characteristicId Int
  value            String
  showOnCard       Boolean        @default(false)
  sortOrder        Int            @default(0)
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, characteristicId])
  @@index([characteristicId])
  @@index([productId, sortOrder])
}

model User {
  id                    Int                 @id @default(autoincrement())
  username              String?
  firstName             String
  lastName              String?
  avatarUrl             String?
  phone                 String?
  createdAt             DateTime            @default(now())
  personalDataConsentAt DateTime?
  role                  RoleKind            @default(CLIENT)
  orderLines            OrderLine[]
  payments              Payment[]
  purchaseOrders        PurchaseOrder[]
  notifications         Notification[]
  telegramCredential    TelegramCredential?
  vkCredential          VkCredential?

  @@index([createdAt])
  @@index([username])
  @@index([phone])
}

model TelegramCredential {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  telegramId String   @unique
  username   String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VkCredential {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  vkId      String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  contact   String?
  notes     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     PurchaseItem[]

  @@index([position])
}

model Currency {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  symbol    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     PurchaseItem[]
  rates     PurchaseCurrencyRate[]

  @@index([position])
}

model Product {
  id                    Int                          @id @default(autoincrement())
  name                  String
  unitCode              String                       @default("piece")
  multiplicity          Decimal                      @default(1) @db.Decimal(10, 3)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  articleNumber         String?
  brandId               Int?
  version               Int                          @default(0)
  brand                 ProductAttribute?            @relation("ProductBrand", fields: [brandId], references: [id])
  attributeValues       ProductAttributeValue[]
  characteristicValues  ProductCharacteristicValue[]
  photos                ProductPhoto[]
  purchaseItems         PurchaseItem[]

  @@index([createdAt])
  @@index([brandId])
}

model ProductPhoto {
  id        Int      @id @default(autoincrement())
  productId Int
  mimeType  String   @default("image/jpeg")
  sortOrder Int      @default(0)
  objectKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Purchase {
  id                Int                       @id @default(autoincrement())
  tag               String                    @unique
  status            PurchaseStatus            @default(DRAFT)
  createdAt         DateTime                  @default(now())
  fulfillmentStatus PurchaseFulfillmentStatus @default(COLLECTION)
  deliveryPercent   Decimal                   @default(0) @db.Decimal(5, 2)
  deletedAt         DateTime?
  payments          Payment[]
  promoCodes        PromoCode[]
  items             PurchaseItem[]
  purchaseOrders    PurchaseOrder[]
  currencyRates     PurchaseCurrencyRate[]

  @@index([status])
  @@index([createdAt])
  @@index([fulfillmentStatus])
}

model PurchaseCurrencyRate {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  currencyId Int
  rateToRub  Decimal  @db.Decimal(10, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([purchaseId, currencyId])
  @@index([purchaseId])
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  userId     Int
  purchaseId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comment         String?
  commentAuthor   Int?      // userId админа, оставившего последнюю запись
  commentAt       DateTime? // момент последнего редактирования comment
  handoffStatus   HandoffStatus?
  handoffAt       DateTime?
  handoffBy       Int?
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@unique([userId, purchaseId])
  @@index([userId])
  @@index([purchaseId])
}

model PurchaseItem {
  id               Int              @id @default(autoincrement())
  purchaseId       Int
  productId        Int
  // Опциональная привязка к поставщику (справочник Supplier). Один и тот же
  // товар можно добавить в закупку несколько раз для разных поставщиков.
  supplierId       Int?
  // Per-purchase конкретика (перенесена с Product в рамках рефакторинга
  // «Product = каталог, PurchaseItem = конкретика закупки»):
  description           String?   // HTML после applyPostTemplate
  minPackageAmount      Decimal?  @db.Decimal(10, 3)
  minPackageUnit        String?
  // Шаг +/− на этапе добора (REORDER+). Если null — используется обычная фасовка.
  supplementStep   Decimal?         @db.Decimal(10, 3)
  targetRemainder  Decimal?         @db.Decimal(10, 3)
  // Максимум, который один покупатель может заказать (в ед. supplierLimitUnit).
  // Если null — без ограничений. Действует на всех этапах.
  supplierLimit    Decimal?         @db.Decimal(10, 3)
  supplierLimitUnit String?
  tgMessageId      String?
  tgChannelId      String?
  publicationState PublicationState @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  // --- Новая модель цен (валюта + курс + оргсбор):
  //     «цена за упаковку в валюте × курс × оргсбор → цена за 1ед». ---
  packAmount              Decimal?  @db.Decimal(10, 3)
  packUnit                String?
  unitCode                String    @default("piece")
  currencyId              Int?
  pricePerPackCurrency    Decimal?  @db.Decimal(10, 4)
  orgFeePercentOverride   Decimal?  @db.Decimal(5, 2)
  deliveryPercentOverride Decimal?  @db.Decimal(5, 2)
  // Операционные количества (в базовых единицах, гр/шт). Заполняются организатором.
  orderedQty              Decimal?  @db.Decimal(10, 3)
  assembledQty            Decimal?  @db.Decimal(10, 3)
  reorderedQty            Decimal?  @db.Decimal(10, 3)
  adminComment            String?
  hidden                  Boolean   @default(false)
  orderLines       OrderLine[]
  product          Product          @relation(fields: [productId], references: [id])
  purchase         Purchase         @relation(fields: [purchaseId], references: [id])
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  currency         Currency?        @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@index([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
  @@index([supplierId])
  @@index([currencyId])
}

model OrderLine {
  id              Int             @id @default(autoincrement())
  purchaseItemId  Int
  userId          Int
  // FK на PurchaseOrder (userId+purchaseId). Связь обязательна:
  // PurchaseOrder создаётся в OrderRepository.upsertOrderLine перед строкой.
  purchaseOrderId Int
  quantity        Decimal         @db.Decimal(10, 3)
  amountDue       Decimal         @db.Decimal(10, 2)
  status          OrderLineStatus @default(ACTIVE)

  // Этап закупки, на котором была создана эта строка.
  // COLLECTION — базовый заказ (замораживается на PAYMENT+).
  // PAYMENT+ — доборный заказ из остатков (можно убирать до 0).
  createdOnStage PurchaseFulfillmentStatus @default(COLLECTION)

  // Замороженный снимок quantity из COLLECTION. Устанавливается при
  // COLLECTION→REORDER. NULL для supplement-строк (PAYMENT+).
  // Используется только на REORDER для расчёта пула добора.
  baseQuantity Decimal? @db.Decimal(10, 3)

  // Замороженный снимок packageCount из COLLECTION. Устанавливается при
  // COLLECTION→REORDER атомарно с baseQuantity. NULL для supplement-строк
  // и для COLLECTION-строк до заморозки.
  basePackageCount Int?

  // Количество целых упаковок поставщика. Упаковка — нераспечатанная пачка,
  // которую организатор отправляет как есть (без расфасовки).
  // Не влияет на расчёт остатка/пула добора.
  packageCount Int @default(0)

  tgChatMessageId BigInt?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  purchaseItem    PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@unique([purchaseItemId, userId, createdOnStage])
  @@index([userId])
  @@index([purchaseItemId])
  @@index([status])
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  purchaseId     Int
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  userComment    String?
  adminNote      String?
  submittedAt    DateTime      @default(now())
  promoCodeId    Int?
  parentId       Int?
  proofObjectKey String?
  parent         Payment?      @relation("PaymentChildren", fields: [parentId], references: [id])
  children       Payment[]     @relation("PaymentChildren")
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id])
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([purchaseId])
  @@index([parentId])
  @@index([promoCodeId])
}

model PostTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  body      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model PromoCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  label      String?
  type       PromoType
  value      Decimal   @db.Decimal(10, 2)
  purchaseId Int?
  maxUses    Int?
  usedCount  Int       @default(0)
  minAmount  Decimal?  @db.Decimal(10, 2)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  usages     Payment[]
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int
  type          String
  payload       Json
  title         String
  body          String
  url           String?
  readAt        DateTime?
  tgDeliveredAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tgDeliveredAt])
}

enum PurchaseStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARRIVED
  DONE
}

enum PurchaseFulfillmentStatus {
  COLLECTION
  REORDER
  PAYMENT
  SUPPLIER_ASSEMBLY
  PREPARING_SHIPMENT_RF
  IN_TRANSIT_RF
  IN_TRANSIT_TO_ORGANIZER
  PACKAGING
  READY_FOR_PICKUP
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PromoType {
  PERCENT
  FIXED
}

enum RoleKind {
  ADMIN
  CLIENT
}

enum PublicationState {
  DRAFT
  PUBLISHED
}

enum OrderLineStatus {
  ACTIVE
  CANCELLED
}

enum HandoffStatus {
  ASSEMBLED
  READY_TO_SHIP
  SENT
  RECEIVED
  STORED
}
